# WishPanel needs NO environment variables for its configuration.
# Every URL, API key and option is set in the web UI (Admin → Settings) and
# stored encrypted in /config. These are the only variables it reads:

PUID=99
PGID=100
TZ=America/Los_Angeles
# UMASK=022
# PORT=8080                  # port inside the container
# LOG_LEVEL=info             # debug | info | warning | error
# BASE_URL=                  # e.g. /wishpanel when served under a sub-path
# FORWARDED_ALLOW_IPS=127.0.0.1  # reverse proxies trusted for X-Forwarded-*

# Migrating from Comic Requests v1? On the very first boot WishPanel imports
# KAVITA_URL, KAVITA_API_KEY, KAPOWARR_URL, KAPOWARR_API_KEY, SUWAYOMI_URL,
# SUWAYOMI_USERNAME/PASSWORD, COMICVINE_API_KEY and DAILY_REQUEST_LIMIT if they
# are set, then ignores them forever. Remove them from your template afterwards.
